# PostgreSQL: use postgresql+psycopg://. For Supabase, prefer the session pooler for the web app.
DATABASE_URL=postgresql+psycopg://procurement:procurement@localhost:5432/procurement
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_USE_NULL_POOL=false

# V1 beta authentication. The publishable key is low privilege; this server keeps it in environment.
AUTH_PROVIDER=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-locally
SUPABASE_JWT_AUDIENCE=authenticated
AUTH_REDIRECT_URL=http://127.0.0.1:8000/login
COOKIE_SECURE=false

# Worker snapshots. Never expose the secret key to browser JavaScript.
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_BUCKET=raw-scrapes
LOCAL_STORAGE_PATH=/tmp/procurement-raw
SUPABASE_SECRET_KEY=replace-only-in-server-or-worker-secret-store
RAW_SNAPSHOT_PREFIX=raw-scrapes

# Provider-neutral structured logs are the beta default.
METRICS_PROVIDER=logs

# Future AWS/Cognito target (unused while AUTH_PROVIDER=supabase).
AWS_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
RAW_SNAPSHOT_BUCKET=
CLOUDWATCH_NAMESPACE=
